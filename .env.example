# 复制为 .env.local；此文件只放占位值。
NOVEL_MODEL_PROVIDER=chat
CHAT_BASE_URL=https://proxy.example.com/v1
CHAT_API_KEY=replace-with-your-api-key
CHAT_MODEL=gemini-3-flash

# 国内官方 API 与代理都使用 chat。DeepSeek 示例见 docs/model-configuration.md。
# 预设只决定默认能力，不修改地址、密钥、模型 ID。未设置时保持现有 Gemini 行为。
# CHAT_PRESET=deepseek
# 以下均可选；未设置时使用预设默认值。
# CHAT_JSON_MODE=json_object        # json_schema / json_object / prompt
# CHAT_THINKING=disabled            # default / enabled / disabled（DeepSeek thinking.type 格式）
# CHAT_REASONING_EFFORT=low         # low / high / max，需要 CHAT_THINKING=enabled
# CHAT_MAX_OUTPUT_TOKENS=16384      # 按服务商对该模型的实际输出上限填写
# CHAT_STREAM=auto                 # auto / always / never
# CHAT_STREAM_INCLUDE_USAGE=true
# CHAT_TIMEOUT_MS=300000

# 使用旧 Claude 接入时显式设置 NOVEL_MODEL_PROVIDER=claude，并配置：
# ANTHROPIC_API_KEY=replace-with-your-api-key
