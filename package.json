{
  "name": "novel-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web --noEmit && tsc -p test/e2e --noEmit",
    "test": "vitest run",
    "acceptance:m1": "tsx src/harness/ten-chapters.ts",
    "acceptance:chat": "node --env-file-if-exists=.env.local --import tsx src/harness/chat-smoke.ts",
    "seed": "tsx src/harness/seed-demo.ts",
    "serve": "node --env-file-if-exists=.env.local --import tsx src/server/main.ts",
    "web": "vite --config web/vite.config.ts web",
    "web:build": "vite build --config web/vite.config.ts web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@langchain/langgraph": "^1.4.14",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.3"
  }
}
